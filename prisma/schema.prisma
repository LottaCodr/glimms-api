generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Users & Auth
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String?
  name          String?
  avatarUrl     String?
  tier          Tier           @default(FREE)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  refreshTokens  RefreshToken[]
  subscription   Subscription?
  preferences    UserPreferences?
  catalogItems   CatalogItem[]
  designJobs     DesignJob[]
  savedDesigns   SavedDesign[]
  deviceTokens   DeviceToken[]

  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model UserPreferences {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  occupation   String?
  styleGoals   String[]
  occasions    String[]
  culturalCtx  String?
  location     Json?    // { lat, lon, city, country }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("user_preferences")
}

// ─────────────────────────────────────────────────────────────────────────────
// Subscriptions (Stripe)
// ─────────────────────────────────────────────────────────────────────────────

model Subscription {
  id                   String        @id @default(uuid())
  userId               String        @unique
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?       @unique
  stripeSubscriptionId String?
  status               SubStatus     @default(INACTIVE)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@map("subscriptions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Catalog (detected items)
// ─────────────────────────────────────────────────────────────────────────────

model CatalogItem {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vertical     Vertical
  label        String
  category     String
  color        Json      // { dominant: {hex, rgb}, palette: [...] }
  texture      String?
  pattern      String?
  imageKey     String    // S3 key
  thumbnailKey String?
  confidence   Float
  attributes   Json      @default("{}")
  tags         String[]
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, vertical])
  @@index([userId, isActive])
  @@map("catalog_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// Design Jobs & Saved Designs
// ─────────────────────────────────────────────────────────────────────────────

model DesignJob {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vertical    Vertical
  status      JobStatus @default(PENDING)
  imageKeys   String[]
  contextData Json      @default("{}")
  result      Json?
  errorMsg    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  savedDesigns SavedDesign[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("design_jobs")
}

model SavedDesign {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId       String
  job         DesignJob @relation(fields: [jobId], references: [id])
  title       String?
  items       Json      // array of catalog item refs
  mockupUrl   String?
  explanation String?
  tips        String[]
  score       Float     @default(0)
  isFavorite  Boolean   @default(false)
  tags        String[]
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([userId, isFavorite])
  @@map("saved_designs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────────────────────

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   // ios | android
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("device_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Tier {
  FREE
  PREMIUM
  PRO
}

enum SubStatus {
  ACTIVE
  INACTIVE
  PAST_DUE
  CANCELLED
}

enum Vertical {
  WARDROBE
  ROOM
  GARDEN
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
