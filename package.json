{
  "name": "glimms-api",
  "version": "1.0.0",
  "description": "Glimms — unified Express.js API server with MongoDB/Mongoose",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint 'src/**/*.ts' --fix",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "seed": "ts-node src/database/seed.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "mongoose": "9.1.3",
    "dotenv": "^16.3.1",
    "zod": "^3.22.4",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "express-rate-limit": "^7.1.5",
    "rate-limit-redis": "^4.2.0",
    "ioredis": "^5.3.2",
    "bullmq": "^5.1.1",
    "socket.io": "^4.6.2",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.1",
    "@aws-sdk/client-s3": "^3.468.0",
    "@aws-sdk/s3-request-presigner": "^3.468.0",
    "axios": "^1.6.7",
    "stripe": "^14.11.0",
    "firebase-admin": "^12.0.0",
    "@sendgrid/mail": "^8.1.0",
    "@pinecone-database/pinecone": "^2.0.1",
    "pino": "^8.16.2",
    "pino-http": "^9.0.0",
    "pino-pretty": "^10.3.1",
    "opossum": "^8.1.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/multer": "^1.4.11",
    "@types/uuid": "^9.0.7",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2",
    "ts-node-dev": "^2.0.0",
    "ts-node": "^10.9.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@types/jest": "^29.5.11",
    "supertest": "^6.3.4",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "eslint": "^8.56.0"
  }
}
