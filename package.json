{
  "name": "glimms-api",
  "version": "1.0.0",
  "description": "Glimms — unified Express.js API server with MongoDB/Mongoose",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/server.ts",
    "services:up": "docker compose up -d mongo redis",
    "services:down": "docker compose stop mongo redis",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint 'src/**/*.ts' --fix",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "seed": "ts-node src/database/seed.ts"
  },
  "dependencies": {
    "express": "^4.20.0",
    "express-async-errors": "^3.1.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "mongoose": "^9.8.1",
    "dotenv": "^16.4.5",
    "zod": "^3.22.4",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "express-rate-limit": "^7.4.0",
    "rate-limit-redis": "^4.2.0",
    "ioredis": "^5.4.1",
    "bullmq": "^5.12.0",
    "socket.io": "^4.8.1",
    "multer": "^2.0.1",
    "sharp": "^0.35.0",
    "@aws-sdk/client-s3": "^3.620.0",
    "@aws-sdk/s3-request-presigner": "^3.620.0",
    "axios": "^1.7.2",
    "stripe": "^14.21.0",
    "firebase-admin": "^12.4.0",
    "@sendgrid/mail": "^8.1.4",
    "@pinecone-database/pinecone": "^2.2.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "pino-pretty": "^13.0.0",
    "opossum": "^8.1.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/multer": "^1.4.12",
    "@types/uuid": "^10.0.0",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4",
    "ts-node-dev": "^2.0.0",
    "ts-node": "^10.9.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "@types/jest": "^29.5.12",
    "supertest": "^6.3.4",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1"
  },
  "overrides": {
    "brace-expansion": "^2.1.2",
    "minimatch": "^9.0.5",
    "fast-uri": "^3.1.5",
    "uuid": "^11.0.3"
  }
}
