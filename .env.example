# ── App ──────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/glimms
# For Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/glimms?retryWrites=true&w=majority

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=super-secret-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=another-secret-change-in-production
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Bcrypt ────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── AWS / S3 ──────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=glimms-images
S3_PRESIGN_EXPIRY_SECONDS=900

# ── AI Services (Python FastAPI) ───────────────────────────────────────────────
# Local dev (docker-compose): use http://localhost:8001 etc.
# Production (private DNS / k8s): use http://object-detection:8001 etc. — never expose to frontend
AI_OBJECT_DETECTION_URL=http://localhost:8001
AI_ATTRIBUTE_EXTRACTOR_URL=http://localhost:8002
AI_EMBEDDING_ENGINE_URL=http://localhost:8003
AI_PERMUTATION_ENGINE_URL=http://localhost:8004
AI_LLM_REASONING_URL=http://localhost:8005
AI_MOCKUP_COMPOSITOR_URL=http://localhost:8006
AI_QUALITY_GUARD_URL=http://localhost:8007
AI_CONTEXT_INFERENCE_URL=http://localhost:8008
# Service-to-service auth — set in production (secret manager), optional in dev
AI_INTERNAL_TOKEN=

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_FREE_SCAN_LIMIT=10
STRIPE_PREMIUM_SCAN_LIMIT=100

# ── Firebase (Push Notifications) ─────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── SendGrid ──────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=hello@glimms.ai

# ── Pinecone ──────────────────────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX=glimms-style

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,exp://localhost:8081
# Production example: ALLOWED_ORIGINS=https://app.glimms.ai,https://www.glimms.ai

# ── Rate Limits ───────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── OpenWeather (optional) ────────────────────────────────────────────────────
OPENWEATHER_API_KEY=
